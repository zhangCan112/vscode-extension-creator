{
  "compilerOptions": {
    "module": "Node16",
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "out"
  },
  "exclude": ["node_modules", ".vscode-test", "dist"]
}
