{
  "name": "ext-ts-esbuild",
  "displayName": "ext-ts-esbuild",
  "description": "Minimal VS Code extension template (TypeScript + esbuild)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "template.hello",
        "title": "Hello",
        "category": "Template"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm run check-types && node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
