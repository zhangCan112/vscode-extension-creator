{
  "name": "module-policy-graph",
  "displayName": "模块访问策略图",
  "description": "每个模块一个 policy 文件，用固定消息类型（call/query/command/event）声明模块间访问关系；Webview 以分层 DAG 布局可视化依赖方向，支持按类型/层级过滤与循环依赖检测。",
  "version": "0.1.0",
  "publisher": "indie-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "modulePolicies.openGraph",
        "title": "打开模块访问策略图",
        "category": "模块策略",
        "icon": "$(graph)"
      },
      {
        "command": "modulePolicies.refresh",
        "title": "重新加载策略文件",
        "category": "模块策略",
        "icon": "$(refresh)"
      },
      {
        "command": "modulePolicies.demoLarge",
        "title": "加载 100 模块演示数据",
        "category": "模块策略",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "modulePolicies.openGraph",
          "when": "view == modulePolicies.overview",
          "group": "navigation",
          "order": 0
        },
        {
          "command": "modulePolicies.refresh",
          "when": "view == modulePolicies.overview",
          "group": "navigation",
          "order": 1
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modulePolicies",
          "title": "模块策略",
          "icon": "media/bar.svg"
        }
      ]
    },
    "views": {
      "modulePolicies": [
        {
          "id": "modulePolicies.overview",
          "name": "访问策略"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modulePolicies.overview",
        "contents": "查看模块间的访问策略依赖。\n[打开模块访问策略图](command:modulePolicies.openGraph)\n[重新加载策略文件](command:modulePolicies.refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm run check-types && node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
