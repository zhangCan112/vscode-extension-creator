{
  "name": "greek-relations",
  "displayName": "Greek Relations",
  "description": "Explore Greek mythology deity relations: live search by deity or relation type, with a synced sidebar tree.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "indie-dev",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "greekRelations.search",
        "title": "Search Deities & Relations",
        "category": "Greek Relations",
        "icon": "$(search)"
      },
      {
        "command": "greekRelations.clearFilter",
        "title": "Clear Focus",
        "category": "Greek Relations",
        "icon": "$(clear-all)"
      },
      {
        "command": "greekRelations.focusDeity",
        "title": "Focus Deity",
        "category": "Greek Relations"
      },
      {
        "command": "greekRelations.openGraph",
        "title": "Open Relations Graph",
        "category": "Greek Relations",
        "icon": "$(graph)"
      },
      {
        "command": "greekRelations.openLog",
        "title": "Open Log",
        "category": "Greek Relations"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "greekRelations.openGraph",
          "when": "view == greekRelationsTree",
          "group": "navigation@0"
        },
        {
          "command": "greekRelations.search",
          "when": "view == greekRelationsTree",
          "group": "navigation@1"
        },
        {
          "command": "greekRelations.clearFilter",
          "when": "view == greekRelationsTree",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "greekRelations.clearFilter",
          "when": "false"
        },
        {
          "command": "greekRelations.focusDeity",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "greekRelations",
          "title": "Greek Relations",
          "icon": "media/bar.svg"
        }
      ]
    },
    "views": {
      "greekRelations": [
        {
          "id": "greekRelationsTree",
          "name": "Deities & Relations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "greekRelationsTree",
        "contents": "Nothing in focus yet.\n[Search deities and relations](command:greekRelations.search)\nPick a deity or a relation pair and this tree will follow your choice."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm run check-types && node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.3"
  }
}
